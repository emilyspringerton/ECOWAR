# REDGARDEN arena persistent bot pool — user-level systemd unit (no sudo required)
#
# Deploy:
#   mkdir -p ~/.config/systemd/user
#   cp ops/systemd/redgarden-bot-pool.service ~/.config/systemd/user/
#   bash scripts/build.sh
#   systemctl --user daemon-reload
#   systemctl --user enable --now redgarden-bot-pool.service
#
# Added 2026-07-24 (EMILY/BACKLOG.md S170-65). Must start after
# redgarden-matchmaker-bots.service -- ordered via After=/Wants= below.
#
# REDGARDEN_TICKET_SECRET (S170-72) is REQUIRED here, not optional: apps/arena_bot mints its own
# connect ticket from this env var when it has no real WOTAN identity (the self-mint fallback,
# same one apps/arena uses via PLAY.bat). Without it, every bot queues into the matchmaker fine
# (queuing doesn't need a ticket) but then silently fails PACKET_CONNECT to the spawned game
# server -- the match forms, sits at 0/N connected until its 60s no-progress timeout, and the
# whole pool re-queues into a fresh, equally-doomed match. This was the actual root cause of "no
# entities visible" during live testing: matches were never truly starting at all, not a
# rendering bug. Confirmed live: this unit ran with NO Environment= line since it was first
# written, only the two matchmaker units had the secret set.
#
# Supervision granularity: scripts/run_bot_pool.sh exits (and takes the whole pool down with it,
# via its own cleanup trap) as soon as *any single* bot process dies, and systemd's Restart=
# relaunches the full set. Coarser than per-bot restart, but simple and correct -- a pool losing
# one bot briefly to relaunch all N is a fine tradeoff against added complexity here.
#
# S170-183, founder: "ok move back to 10 v 10" -- reverts S170-178's brief 7v7 change
# (13 bots + 1 open slot / 14 total) back to 19 + 1 (20/10v10), matching ARENA_TEAM_SIZE's
# own revert.
#
# 2026-07-30, founder: "add a 20th bot and ensure stats is working." Bumped 19->20 -- real
# consequence found while investigating why the hero-leaderboard stayed empty even after fixing
# the IDUNA-agent-credentials gap (see redgarden-matchmaker-bots.service's own EnvironmentFile
# doc comment): the matchmaker only ever spawns a match once its queue reaches lobby_size (20)
# exactly (apps/matchmaker/src/main.c: `while (queue_count >= lobby_size)`), so with only 19 bots
# and no human queued, the pool sits at 19/20 FOREVER and no match -- and therefore no hero-result
# data -- has ever been generated by this pool on its own. 20 bots means the pool is fully
# self-sustaining (a match starts immediately and every bot requeues into the next one the
# instant its match ends), a deliberate tradeoff: a human can no longer queue into THIS lobby at
# all (:7778) since it's always already full. A human wanting a real match still has the
# player-only pool (:7779, redgarden-matchmaker-players.service) or can drop this back to 19
# manually if they want the "verse 19 bots" experience back.
#
# 2026-07-30, same-day follow-up, founder: "take the bot pool back down to 19." Reverted the
# 20-bot change directly above -- the self-sustaining-data-generation tradeoff was deliberate but
# short-lived; a human being able to queue into this lobby again mattered more once the stats
# pipeline itself had already been proven working.
#
# 2026-07-30, same-day follow-up again, founder: "bring bot pool back up to 20." Back to 20 --
# self-sustaining match generation again, same tradeoff (no human can queue into :7778) named
# above, re-accepted. Given the founder's own next-door observation this same session about
# restart-caused match interruptions (input lag traced to live redeploys killing in-progress
# matches, not the live-feed reporter), this particular restart is a directly-requested,
# deliberate action, not an incidental "verify every small change immediately" one -- the
# distinction the founder and this session's own operating pattern landed on right before this.
#
# This file is a deploy SOURCE, not the live unit itself (see the Deploy: steps above) --
# editing it here does not restart or otherwise touch the actual running pool; that needs a
# manual re-copy + `systemctl --user restart` on the host, a real live-infra action outside this
# repo's own git history and deliberately not done as part of this commit.

[Unit]
Description=REDGARDEN arena persistent bot pool (20 bots, fully self-sustaining -> bot-pool matchmaker :7778)
After=network-online.target redgarden-matchmaker-bots.service
Wants=redgarden-matchmaker-bots.service

[Service]
Type=simple
WorkingDirectory=/home/fatbaby/REDGARDEN
Environment=REDGARDEN_TICKET_SECRET=test-secret-for-vs0-vs1-validation
ExecStartPre=/bin/sleep 2
ExecStart=/home/fatbaby/REDGARDEN/scripts/run_bot_pool.sh 20
Restart=on-failure
RestartSec=5s
StandardOutput=append:/home/fatbaby/REDGARDEN/var/logs/bot-pool.log
StandardError=append:/home/fatbaby/REDGARDEN/var/logs/bot-pool.log
MemoryMax=256M

[Install]
WantedBy=default.target
