load("@rules_cc//cc:defs.bzl", "cc_test")

# Same "-std=c99 -Wall -Wextra" bar every real test in this repo already holds itself to
# (scripts/test_arena.sh's own gcc invocation) -- global via .bazelrc for the rest, but
# cc_test's own default copts don't inherit `build --copt=...` the same way a plain
# `bazel build` target does, so each test below repeats it explicitly, matching PARENA's
# own tests/BUILD.bazel precedent.
COMMON_TEST_COPTS = ["-std=c99", "-Wall", "-Wextra"]

cc_test(
    name = "test_arena_game",
    srcs = ["test_arena_game.c"],
    deps = ["//packages/simulation:arena_game"],
    copts = COMMON_TEST_COPTS,
)

# Living Map (docs/NORTHSTAR_LIVING_MAP.md, BACKLOG.md SECTION 377) -- deliberately depends on
# :living_map only, not :arena_game, matching that package's own "new, standalone layer" design.
